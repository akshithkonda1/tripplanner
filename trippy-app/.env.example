# Claude AI
CLAUDE_API_KEY=your_claude_api_key_here

# OpenWeather
OPENWEATHER_API_KEY=your_openweather_api_key_here

# GraphHopper (optional, for server-side routing)
GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here

# Booking Affiliate IDs
BOOKING_AFFILIATE_ID=your_booking_affiliate_id
EXPEDIA_AFFILIATE_ID=your_expedia_affiliate_id
VIATOR_PARTNER_ID=your_viator_partner_id

# AWS (for deployment)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your_aws_account_id
CDK_DEFAULT_ACCOUNT=your_aws_account_id
CDK_DEFAULT_REGION=us-east-1

# API Endpoints (set after deployment)
HTTP_API_URL=https://your-api.execute-api.us-east-1.amazonaws.com
WS_API_URL=wss://your-ws-api.execute-api.us-east-1.amazonaws.com/production
