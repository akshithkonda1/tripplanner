# Remote state template. Copy to backend.tf and fill in a pre-existing bucket
# and lock table, then run `terraform init -migrate-state`.
#
# Create the backend resources once (they are cheap: an S3 bucket + a small
# on-demand DynamoDB lock table):
#
#   aws s3api create-bucket --bucket my-tf-state-bucket --region us-east-1
#   aws s3api put-bucket-versioning --bucket my-tf-state-bucket \
#     --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name terraform-locks \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST

# terraform {
#   backend "s3" {
#     bucket         = "my-tf-state-bucket"
#     key            = "trippy/terraform.tfstate"
#     region         = "us-east-1"
#     dynamodb_table = "terraform-locks"
#     encrypt        = true
#   }
# }
